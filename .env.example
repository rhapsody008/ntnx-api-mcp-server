# ── Prism Central connection ──────────────────────────────────────────────────
# IP address or FQDN only — no "https://" prefix, no trailing slash.
# Example: PC_HOST=10.1.1.10  or  PC_HOST=prism.example.com
PC_HOST=10.1.1.10
PC_PORT=9440

# ── Authentication (choose one) ───────────────────────────────────────────────
# Option A [Recommended] — API key (sent as X-ntnx-api-key header)
# Mutually exclusive with Option B — set one or the other, not both.
PC_API_KEY=

# Option B — basic auth (username + password)
PC_USERNAME=admin
PC_PASSWORD=changeme

# ── TLS ───────────────────────────────────────────────────────────────────────
# false = enforce TLS certificate verification (default; recommended for production)
# true  = skip certificate verification (use only for dev/test with self-signed certs)
PC_INSECURE=false

# ── Artifact storage ──────────────────────────────────────────────────────────
# Absolute path to the directory where downloaded OpenAPI YAML specs are stored.
# Created automatically on first run. Must be absolute when used in AI client
# config files (mcp.json / claude_desktop_config.json) — relative paths are not
# resolved from the config file location.
# Example: ARTIFACTS_DIR=/home/user/.nutanix-mcp/artifacts
ARTIFACTS_DIR=./artifacts

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL  (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT: text | json  (default: text; use json for log aggregation pipelines)
LOG_FORMAT=text
# Absolute path for per-restart log files. A timestamped file is created each startup.
LOG_DIR=./logs

# ── Namespace discovery ───────────────────────────────────────────────────────
# Endpoint that returns the list of available API namespaces.
# Override only when mirroring the Nutanix developer portal on a private network.
NAMESPACE_SOURCE_URL=https://developers.nutanix.com/api/v1/namespaces

# ── Runtime controls ──────────────────────────────────────────────────────────
# true  = block all non-GET operations server-side (default; recommended)
# false = allow write operations — set explicitly to opt in to create/update/delete
READ_ONLY_MODE=true

# Reject unknown parameter keys with an unknown_parameter error (lists accepted names)
# instead of silently dropping them.
STRICT_PARAMS=true

# When a write needs If-Match and the caller omits it, fetch the resource's current
# ETag server-side and inject it. Saves the model a GET per resource, but drops
# optimistic-concurrency protection between the model's earlier read and its write.
AUTO_ETAG=false

# ── Streamable HTTP transport (nutanix-mcp serve-http) ────────────────────────
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp
# Bearer token required on the MCP path when set. Strongly recommended for any
# non-loopback bind: this server can write to Prism Central.
# Generate with: openssl rand -base64 32
MCP_AUTH_TOKEN=
# true = stateless mode with JSON responses (required for >1 replica without
# sticky sessions); false = session-based mode with SSE streams.
MCP_STATELESS=false
